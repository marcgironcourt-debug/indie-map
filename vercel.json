{
  "headers": [
    {
      "source": "/downloads_webp/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/v1/cron/contextual-notifications",
      "schedule": "0 11 * * *"
    }
  ]
}
