generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Place {
  id           String   @id @default(cuid())
  name         String
  city         String
  address      String?
  website      String?
  openingHours String?
  lat          Float?
  lng          Float?
  description  String?
  category     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Business {
  id            String   @id @default(cuid())
  name          String
  descriptionFr String?
  descriptionEn String?
  aiGenerated   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Event {
  id        String   @id @default(uuid())
  eventType String
  placeId   String
  city      String
  category  String
  createdAt DateTime @default(now())
}


model Submission {
  id           String   @id @default(uuid())
  locale       String
  name         String
  address      String
  openingHours String?
  phone        String?
  website      String?
  photoMime    String?
  photoBase64  String?
  createdAt    DateTime @default(now())
  status     String   @default("pending")
  reviewedAt DateTime?
}

model ActiveSession {
  sessionId  String   @id
  city       String?
  country    String?
  platform   String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
model DailyActiveUser {
  id        String   @id @default(uuid())
  day       String
  sessionId String
  city      String?
  country   String?
  platform  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([day, sessionId])
  @@index([day])
}

model DailySession {
  id        String   @id @default(uuid())
  day       String
  launchId  String
  sessionId String
  city      String?
  country   String?
  platform  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([day, launchId])
  @@index([day])
}
