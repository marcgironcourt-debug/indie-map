generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Place {
  id           String   @id @default(cuid())
  name         String
  city         String
  address      String?
  website      String?
  openingHours String?
  lat          Float?
  lng          Float?
  description  String?
  category     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Business {
  id            String   @id @default(cuid())
  name          String
  descriptionFr String?
  descriptionEn String?
  aiGenerated   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Event {
  id               String   @id @default(uuid())
  eventType        String
  placeId          String?
  city             String?
  country          String?
  category         String?
  sessionId        String?
  launchId         String?
  userId           String?
  locale           String?
  platform         String?
  clientTimeZone   String?
  utcOffsetMinutes Int?
  clientLocalDate  String?
  clientLocalHour  Int?
  metadata         Json?
  createdAt        DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventType])
  @@index([createdAt])
  @@index([userId])
  @@index([sessionId])
  @@index([sessionId, createdAt])
  @@index([launchId])
  @@index([placeId])
  @@index([clientLocalDate])
  @@index([clientLocalDate, createdAt])
  @@index([clientLocalDate, eventType])
}

model Submission {
  id           String    @id @default(uuid())
  locale       String
  name         String
  address      String
  openingHours String?
  phone        String?
  website      String?
  photoMime    String?
  photoBase64  String?
  createdAt    DateTime  @default(now())
  status       String    @default("pending")
  reviewedAt   DateTime?
  reviewToken  String?   @unique
  userId       String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model ActiveSession {
  sessionId        String   @id
  city             String?
  country          String?
  platform         String?
  clientTimeZone   String?
  utcOffsetMinutes Int?
  lastSeenAt       DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model DailyActiveUser {
  id               String   @id @default(uuid())
  day              String
  sessionId        String
  city             String?
  country          String?
  platform         String?
  clientTimeZone   String?
  utcOffsetMinutes Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([day, sessionId])
  @@index([day])
}

model DailySession {
  id               String   @id @default(uuid())
  day              String
  launchId         String
  sessionId        String
  city             String?
  country          String?
  platform         String?
  clientTimeZone   String?
  utcOffsetMinutes Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([day, launchId])
  @@index([day])
}

model User {
  id                            String    @id @default(uuid())
  email                         String?   @unique
  username                      String    @unique
  passwordHash                  String?
  displayName                   String
  avatarUrl                     String?
  avatarColor                   String?
  preferredLocale               String    @default("fr")
  homeCity                      String?
  ageRange                      String?
  commentsVisibleToFriends      Boolean   @default(false)
  visitedPlacesVisibleToFriends Boolean   @default(false)
  profileCompletedAt            DateTime?
  lastKnownLat                  Float?
  lastKnownLng                  Float?
  lastKnownLocationAt           DateTime?
  lastSeenAt                    DateTime?
  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @default(now()) @updatedAt

  submissions                Submission[]
  sentFriendships            Friendship[]                @relation("FriendshipRequester")
  receivedFriendships        Friendship[]                @relation("FriendshipReceiver")
  sentInvites                Invite[]
  places                     UserPlace[]
  comments                   PlaceComment[]
  ownedLists                 SharedList[]                @relation("SharedListOwner")
  listMemberships            SharedListMember[]
  recommendationsSent        PlaceRecommendation[]       @relation("RecommendationSender")
  recommendationsInbox       PlaceRecommendation[]       @relation("RecommendationReceiver")
  sessions                   UserSession[]
  passwordResetTokens        PasswordResetToken[]
  pushDevices                PushDevice[]
  pushInstallations          PushInstallation[]
  contextualNotificationLogs ContextualNotificationLog[]
  appUpdateNotificationLogs  AppUpdateNotificationLog[]
  events                     Event[]
}

model Friendship {
  id          String   @id @default(uuid())
  requesterId String
  receiverId  String
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  receiver  User @relation("FriendshipReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([requesterId, receiverId])
  @@index([receiverId, status])
  @@index([requesterId, status])
}

model Invite {
  id         String    @id @default(uuid())
  senderId   String
  email      String?
  token      String    @unique
  status     String    @default("pending")
  createdAt  DateTime  @default(now())
  acceptedAt DateTime?

  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([email])
}

model UserPlace {
  id         String    @id @default(uuid())
  userId     String
  placeId    String
  visibility String    @default("private")
  saved      Boolean   @default(false)
  visited    Boolean   @default(false)
  visitedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, placeId])
  @@index([placeId])
  @@index([userId, visibility])
}

model PlaceComment {
  id         String   @id @default(uuid())
  userId     String
  placeId    String
  body       String
  visibility String   @default("private")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, placeId])
  @@index([placeId, visibility])
  @@index([userId])
}

model SharedList {
  id        String   @id @default(uuid())
  ownerId   String
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  owner   User               @relation("SharedListOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members SharedListMember[]
  places  SharedListPlace[]

  @@index([ownerId])
}

model SharedListMember {
  id        String    @id @default(uuid())
  listId    String
  userId    String
  role      String    @default("member")
  createdAt DateTime  @default(now())
  seenAt    DateTime?

  list SharedList @relation(fields: [listId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([listId, userId])
  @@index([userId])
}

model SharedListPlace {
  id        String   @id @default(uuid())
  listId    String
  placeId   String
  addedById String?
  createdAt DateTime @default(now())

  list SharedList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([listId, placeId])
  @@index([placeId])
}

model PlaceRecommendation {
  id         String    @id @default(uuid())
  senderId   String
  receiverId String
  placeId    String
  message    String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  sender   User @relation("RecommendationSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("RecommendationReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([receiverId, readAt])
  @@index([senderId])
  @@index([placeId])
}

model LoginToken {
  id        String    @id @default(uuid())
  email     String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserSession {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PushDevice {
  id           String   @id @default(uuid())
  userId       String
  platform     String
  token        String   @unique
  subscription String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([platform])
}

model PushInstallation {
  id                 String    @id @default(uuid())
  sessionId          String    @unique
  userId             String?
  platform           String
  token              String    @unique
  subscription       String?
  locale             String    @default("fr")
  lastSeenAt         DateTime  @default(now())
  lastReactivationAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([platform])
  @@index([lastSeenAt])
  @@index([lastReactivationAt])
}

model ContextualNotificationLog {
  id          String    @id @default(uuid())
  userId      String
  categoryKey String
  placeId     String?
  title       String
  body        String
  sentAt      DateTime  @default(now())
  openedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sentAt])
  @@index([userId, categoryKey, sentAt])
  @@index([placeId])
}

model AppUpdateNotificationLog {
  id       String   @id @default(uuid())
  userId   String
  version  String
  platform String
  title    String
  body     String
  sentAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, version, platform])
  @@index([userId, sentAt])
  @@index([version])
  @@index([platform])
}

//
// INDIE MAP AI V5 — MEMORY FIRST
//
// Règle fondamentale :
// - AiVerifiedFact = connaissance factuelle vérifiée.
// - AiOfficialPageCache = cache technique, pas une vérité en soi.
// - AiSearchSignal = apprentissage de recherche, jamais une preuve factuelle.
//

model AiVerifiedFact {
  id String @id @default(uuid())

  // Lieu Indie Map auquel la preuve a été rattachée.
  // Pas de relation Prisma volontairement :
  // le catalogue de recherche provient actuellement de places.json.
  placeId String

  // Permet d'auditer l'identité utilisée lors de la vérification.
  placeName    String?
  placeAddress String?

  // target_place | brand_general
  scope String

  // Domaine et page officielle d'origine.
  sourceDomain String
  sourceUrl    String

  // Extrait EXACT déjà vérifié dans la page officielle.
  evidenceText String
  evidenceHash String

  // Question qui avait déclenché la découverte de cette preuve.
  // Elle est conservée pour audit mais n'est pas elle-même une vérité.
  verificationQuestion String?

  // Hash de la page au moment de la vérification.
  sourceContentHash String?

  verifierVersion String?

  verifiedAt DateTime @default(now())

  // Toute connaissance doit avoir une politique de fraîcheur.
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([placeId, sourceUrl, evidenceHash])
  @@index([placeId, expiresAt])
  @@index([sourceDomain])
  @@index([expiresAt])
}

model AiOfficialPageCache {
  id String @id @default(uuid())

  // URL normalisée demandée.
  url String @unique

  // URL obtenue après éventuelles redirections.
  finalUrl String?

  contentType String?
  httpStatus  Int?

  // HTML/XML/texte brut : nécessaire pour pouvoir
  // refaire discovery/extraction sans nouvel appel réseau.
  body String

  contentHash String

  etag         String?
  lastModified String?

  fetchedAt DateTime @default(now())
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
  @@index([contentHash])
}

model AiSearchSignal {
  id String @id @default(uuid())

  // On conserve la formulation : les faux négatifs observés
  // dépendent précisément de la façon dont la demande est écrite.
  queryText       String
  normalizedQuery String
  queryHash       String

  // Facultatif : certains signaux concernent une requête entière.
  placeId String?

  // Exemples futurs :
  // result_shown, result_clicked, result_saved,
  // regression_expected, regression_missed,
  // autonomous_pass, autonomous_fail.
  signal String

  // user_behavior | manual_regression | autonomous_test
  source String

  // Métadonnées non factuelles :
  // rang, moteur, score, formulation, résultat attendu, etc.
  payload Json?

  // Influence future sur retrieval/ranking uniquement.
  weight Float @default(1)

  observedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([queryHash])
  @@index([placeId])
  @@index([signal])
  @@index([source])
  @@index([observedAt])
}
