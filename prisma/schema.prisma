generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Place {
  id           String   @id @default(cuid())
  name         String
  city         String
  address      String?
  website      String?
  openingHours String?
  lat          Float?
  lng          Float?
  description  String?
  category     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Business {
  id            String   @id @default(cuid())
  name          String
  descriptionFr String?
  descriptionEn String?
  aiGenerated   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Event {
  id        String   @id @default(uuid())
  eventType String
  placeId   String
  city      String
  category  String
  createdAt DateTime @default(now())
}

model Submission {
  id           String    @id @default(uuid())
  locale       String
  name         String
  address      String
  openingHours String?
  phone        String?
  website      String?
  photoMime    String?
  photoBase64  String?
  createdAt    DateTime  @default(now())
  status       String    @default("pending")
  reviewedAt   DateTime?
}

model ActiveSession {
  sessionId  String   @id
  city       String?
  country    String?
  platform   String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model DailyActiveUser {
  id        String   @id @default(uuid())
  day       String
  sessionId String
  city      String?
  country   String?
  platform  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([day, sessionId])
  @@index([day])
}

model DailySession {
  id        String   @id @default(uuid())
  day       String
  launchId  String
  sessionId String
  city      String?
  country   String?
  platform  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([day, launchId])
  @@index([day])
}

model User {
  id                            String    @id @default(uuid())
  email                         String?   @unique
  username                      String    @unique
  passwordHash                  String?
  displayName                   String
  avatarUrl                     String?
  avatarColor                   String?
  preferredLocale               String    @default("fr")
  homeCity                      String?
  ageRange                      String?
  commentsVisibleToFriends      Boolean   @default(false)
  visitedPlacesVisibleToFriends Boolean   @default(false)
  profileCompletedAt            DateTime?
  lastKnownLat                  Float?
  lastKnownLng                  Float?
  lastKnownLocationAt           DateTime?
  lastSeenAt                    DateTime?
  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt

  sentFriendships            Friendship[]                @relation("FriendshipRequester")
  receivedFriendships        Friendship[]                @relation("FriendshipReceiver")
  sentInvites                Invite[]
  places                     UserPlace[]
  comments                   PlaceComment[]
  ownedLists                 SharedList[]                @relation("SharedListOwner")
  listMemberships            SharedListMember[]
  recommendationsSent        PlaceRecommendation[]       @relation("RecommendationSender")
  recommendationsInbox       PlaceRecommendation[]       @relation("RecommendationReceiver")
  sessions                   UserSession[]
  passwordResetTokens        PasswordResetToken[]
  pushDevices                PushDevice[]
  contextualNotificationLogs ContextualNotificationLog[]
  appUpdateNotificationLogs AppUpdateNotificationLog[]
}

model Friendship {
  id          String   @id @default(uuid())
  requesterId String
  receiverId  String
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  receiver  User @relation("FriendshipReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([requesterId, receiverId])
  @@index([receiverId, status])
  @@index([requesterId, status])
}

model Invite {
  id         String    @id @default(uuid())
  senderId   String
  email      String?
  token      String    @unique
  status     String    @default("pending")
  createdAt  DateTime  @default(now())
  acceptedAt DateTime?

  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([email])
}

model UserPlace {
  id         String    @id @default(uuid())
  userId     String
  placeId    String
  visibility String    @default("private")
  saved      Boolean   @default(false)
  visited    Boolean   @default(false)
  visitedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, placeId])
  @@index([placeId])
  @@index([userId, visibility])
}

model PlaceComment {
  id         String   @id @default(uuid())
  userId     String
  placeId    String
  body       String
  visibility String   @default("private")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, placeId])
  @@index([placeId, visibility])
  @@index([userId])
}

model SharedList {
  id        String   @id @default(uuid())
  ownerId   String
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner   User               @relation("SharedListOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members SharedListMember[]
  places  SharedListPlace[]

  @@index([ownerId])
}

model SharedListMember {
  id        String   @id @default(uuid())
  listId    String
  userId    String
  role      String   @default("member")
  createdAt DateTime @default(now())

  list SharedList @relation(fields: [listId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([listId, userId])
  @@index([userId])
}

model SharedListPlace {
  id        String   @id @default(uuid())
  listId    String
  placeId   String
  addedById String?
  createdAt DateTime @default(now())

  list SharedList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([listId, placeId])
  @@index([placeId])
}

model PlaceRecommendation {
  id         String    @id @default(uuid())
  senderId   String
  receiverId String
  placeId    String
  message    String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  sender   User @relation("RecommendationSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("RecommendationReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([receiverId, readAt])
  @@index([senderId])
  @@index([placeId])
}

model LoginToken {
  id        String    @id @default(uuid())
  email     String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserSession {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PushDevice {
  id           String   @id @default(uuid())
  userId       String
  platform     String
  token        String   @unique
  subscription String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([platform])
}

model ContextualNotificationLog {
  id          String    @id @default(uuid())
  userId      String
  categoryKey String
  placeId     String?
  title       String
  body        String
  sentAt      DateTime  @default(now())
  openedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sentAt])
  @@index([userId, categoryKey, sentAt])
  @@index([placeId])
}

model AppUpdateNotificationLog {
  id       String   @id @default(uuid())
  userId   String
  version  String
  platform String
  title    String
  body     String
  sentAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, version, platform])
  @@index([userId, sentAt])
  @@index([version])
  @@index([platform])
}
